  "query": "select a.id, a.role_id, a.user_id, a.group_id, a.project_id, a.created_at, a.created_by,\n                r.builtin, r.permissions\n         from role_assignments a join roles r on r.id = a.role_id\n         where a.group_id = any($1)\n         order by a.id",
