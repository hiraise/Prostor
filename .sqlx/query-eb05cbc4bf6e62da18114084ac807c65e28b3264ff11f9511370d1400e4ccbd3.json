{
  "db_name": "PostgreSQL",
  "query": "select o.id, o.project_id, o.number, o.summary, o.reporter_id, o.audience_users,\n                o.audience_groups, o.resolved_at, o.deleted_at\n         from issue_links l\n         join link_types t on t.id = l.type_id and t.builtin = 'subtask'\n         join issues o on o.id = l.source_id\n         where l.target_id = $1\n         limit 1",
